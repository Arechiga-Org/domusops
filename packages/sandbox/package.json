{
  "name": "@domusops/sandbox",
  "version": "0.1.0",
  "description": "Ephemeral test harness for Home Assistant: throwaway instances, virtual devices, time control",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "domusops-sandbox": "./dist/cli.js"
  },
  "files": [
    "dist",
    "companion",
    "fixtures",
    "schema"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/sandbox/",
    "test:container": "DOMUSOPS_CONTAINER_TESTS=1 vitest run --root ../.. packages/sandbox/test"
  },
  "dependencies": {
    "@domusops/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
