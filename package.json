{
  "name": "domusops",
  "private": true,
  "version": "0.0.0",
  "description": "GitOps toolkit for Home Assistant",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty && tsc -p packages/schema/tsconfig.test.json && tsc -p packages/mcp/tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm -r --filter=./packages/* build",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
